#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Move auto-token values into a private, age-encrypted fnox configuration."""

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib


class MigrationError(Exception):
    pass


def read_config(path):
    try:
        with path.open("rb") as stream:
            return tomllib.load(stream)
    except (OSError, tomllib.TOMLDecodeError):
        raise MigrationError(f"Cannot read TOML configuration: {path}") from None


def collect(source):
    config = read_config(source)
    token_dir = Path(
        config.get("token_dir", "~/.config/auto-token/tokens")
    ).expanduser()
    if not token_dir.is_dir():
        raise MigrationError("The configured auto-token directory does not exist.")
    groups = {}
    for group in config.get("tokens", []):
        name = group.get("name")
        if not isinstance(name, str) or not name or name in groups:
            raise MigrationError("Invalid or repeated inline token group.")
        groups[name] = group
    for path in sorted(token_dir.glob("*.toml")):
        if path.stem in groups:
            raise MigrationError(f"Token group has multiple definitions: {path.stem}")
        groups[path.stem] = read_config(path)

    profiles = {"default": {}}
    values = {}
    for name, group in groups.items():
        active = group.get("active", True)
        if not isinstance(active, bool):
            raise MigrationError(f"Invalid active state in group: {name}")
        if not active and name == "default":
            raise MigrationError(
                "An inactive group cannot use the reserved profile 'default'."
            )
        profile = "default" if active else name
        for entry in group.get("envs", []):
            key, value = entry.get("name"), entry.get("value")
            if key == "AUTO_TOKEN_ENV_DIR":
                continue
            if not isinstance(key, str) or not re.fullmatch(
                r"[A-Za-z_][A-Za-z0-9_]*", key
            ):
                raise MigrationError(f"Invalid environment name in group: {name}")
            if not isinstance(value, str) or "\0" in value:
                raise MigrationError(f"Invalid environment value for: {key}")
            if entry.get("type", "env") != "env":
                raise MigrationError(f"Unsupported token type for: {key}")
            if key in values and values[key] != value:
                raise MigrationError(f"Conflicting values for: {key}")
            values[key] = value
            profiles.setdefault(profile, {})[key] = value
    return profiles


def private_command(command, environment, *, data=None):
    result = subprocess.run(
        command,
        input=data,
        capture_output=True,
        text=True,
        encoding="utf-8",
        env=environment,
        cwd=environment["FNOX_CONFIG_DIR"],
        check=False,
    )
    if result.returncode:
        # Provider diagnostics may contain input values. Report only the operation.
        raise MigrationError(
            f"{Path(command[0]).name} failed (exit {result.returncode})."
        )
    return result.stdout


def migrate(profiles, destination):
    commands = {}
    for name in ("fnox", "age-keygen"):
        executable = shutil.which(name)
        if executable is None:
            raise MigrationError(f"Required command is missing: {name}")
        commands[name] = executable

    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.mkdir(mode=0o700)
    try:
        with tempfile.TemporaryDirectory(
            prefix=".migration-", dir=destination
        ) as directory:
            stage = Path(directory)
            environment = {
                "PATH": os.environ.get("PATH", os.defpath),
                "HOME": directory,
                "FNOX_CONFIG_DIR": directory,
                "FNOX_PROFILE": "default",
            }
            key = stage / "age.txt"
            private_command([commands["age-keygen"], "-o", str(key)], environment)
            recipient = private_command(
                [commands["age-keygen"], "-y", str(key)], environment
            ).strip()
            config = stage / "config.toml"
            config.write_text(
                'default_provider = "age"\nenv = true\nif_missing = "error"\n'
                'prompt_auth = false\n\n[providers.age]\ntype = "age"\n'
                f"recipients = [{json.dumps(recipient)}]\n",
                encoding="utf-8",
            )
            for profile, secrets in profiles.items():
                if not secrets:
                    continue
                private_command(
                    [
                        commands["fnox"],
                        "--config",
                        str(config),
                        "--profile",
                        profile,
                        "import",
                        "json",
                        "--provider",
                        "age",
                        "--force",
                    ],
                    environment,
                    data=json.dumps(secrets),
                )
            for profile, secrets in profiles.items():
                output = private_command(
                    [
                        commands["fnox"],
                        "--config",
                        str(config),
                        "--profile",
                        profile,
                        "export",
                        "--format",
                        "json",
                        "--all",
                    ],
                    environment,
                )
                expected = profiles["default"] | secrets
                try:
                    actual = json.loads(output)["secrets"]
                except (ValueError, KeyError, TypeError):
                    raise MigrationError(
                        "fnox returned an invalid verification result."
                    ) from None
                if actual != expected:
                    raise MigrationError(
                        f"Decrypted values do not match profile: {profile}"
                    )
            key.chmod(0o600)
            config.chmod(0o600)
            key.replace(destination / "age.txt")
            # Publish the configuration last, after every profile has been verified.
            config.replace(destination / "config.toml")
    except BaseException:
        for name in ("config.toml", "age.txt"):
            (destination / name).unlink(missing_ok=True)
        destination.rmdir()
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument(
        "--dry-run", action="store_true", help="show names and profiles only"
    )
    mode.add_argument(
        "--apply", action="store_true", help="encrypt and verify a new configuration"
    )
    parser.add_argument(
        "--source", type=Path, default=Path.home() / ".config/auto-token/config.toml"
    )
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    parser.add_argument(
        "--destination",
        type=Path,
        default=Path(os.environ.get("FNOX_CONFIG_DIR", config_home / "fnox")),
    )
    args = parser.parse_args()
    destination = args.destination.expanduser().absolute()
    previous_umask = os.umask(0o077)
    try:
        if destination.exists() or destination.is_symlink():
            raise MigrationError(
                "Destination already exists; no configuration or key was changed."
            )
        profiles = collect(args.source.expanduser())
        for profile, secrets in profiles.items():
            print(
                f"{profile}: {len(secrets)} variable(s): {', '.join(sorted(secrets))}"
            )
        if args.dry_run:
            print("Preview only; no files changed.")
            return 0
        migrate(profiles, destination)
        print(f"Encrypted and verified configuration: {destination}")
        print("The original auto-token files are unchanged.")
        return 0
    except (MigrationError, OSError) as error:
        message = (
            str(error)
            if isinstance(error, MigrationError)
            else "Filesystem operation failed."
        )
        print(f"Migration stopped: {message}", file=sys.stderr)
        return 1
    finally:
        os.umask(previous_umask)


if __name__ == "__main__":
    raise SystemExit(main())
